# Server-side only. Never expose this value to browser code.
OPENAI_API_KEY=

# Optional. Defaults to the model used in the official File Search example.
OPENAI_MODEL=gpt-5.6
OPENAI_CHAT_MODEL=gpt-5.6-luna

# Server-side only. 공공데이터포털에서 "조달청_나라장터 가격정보현황서비스" 활용신청 후 발급된 일반 인증키(Encoding)를 입력합니다.
# 기존 DATA_GO_KR_API_KEY도 하위 호환용으로 읽지만, 가격정보 전용 키는 아래 이름을 권장합니다.
DATA_GO_KR_SERVICE_KEY=
